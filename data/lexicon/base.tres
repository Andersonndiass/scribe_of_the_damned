[resource]
script = ExtResource("1_ld")
alphabet = PackedStringArray("A", "C", "D", "E", "F", "G", "I", "L", "M", "N", "O", "P", "Q", "R", "S", "T", "U", "V", "X", "B")
gated_letters = Dictionary[String, StringName]({"B": &"verbum"})
words = Array[ExtResource("2_wd")]([ExtResource("w_lux"), ExtResource("w_pax"), ExtResource("w_crux"), ExtResource("w_vita"), ExtResource("w_aqua"), ExtResource("w_ignis"), ExtResource("w_mortis"), ExtResource("w_fides"), ExtResource("w_lumen"), ExtResource("w_purgo"), ExtResource("w_gloria"), ExtResource("w_verbum"), ExtResource("w_sanctus"), ExtResource("w_dominus"), ExtResource("w_angelus"), ExtResource("w_spiritus"), ExtResource("w_salvator"), ExtResource("w_miserere")])
min_length = 3
max_length = 8
