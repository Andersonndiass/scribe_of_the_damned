[gd_resource type="Resource" script_class="RelicData" format=3]

[ext_resource type="Script" path="res://src/data/relic_data.gd" id="1_rd"]
[ext_resource type="Script" path="res://src/data/relic_level_data.gd" id="2_rl"]
[ext_resource type="Script" path="res://src/data/weapon_upgrade_data.gd" id="3_up"]
[ext_resource type="Texture2D" path="res://assets/placeholders/itm_relic_reverse_magnet_16.png" id="4_icon"]
[ext_resource type="Texture2D" path="res://assets/placeholders/itm_relic_reverse_magnet_24.png" id="5_shop"]

[sub_resource type="Resource" id="base"]
script = ExtResource("2_rl")
interval = 5.0
radius = 56.0
knockback = 40.0
damage = 0

[sub_resource type="Resource" id="up_rate"]
script = ExtResource("3_up")
id = &"rate"
label = "UPG_COOLDOWN"
effects = Dictionary[StringName, PackedFloat64Array]({&"interval": PackedFloat64Array(4.5, 4.0, 3.5)})
display_field = &"interval"
display_unit = &"s"

[sub_resource type="Resource" id="up_reach"]
script = ExtResource("3_up")
id = &"reach"
label = "UPG_RADIUS"
effects = Dictionary[StringName, PackedFloat64Array]({&"radius": PackedFloat64Array(64.0, 72.0)})
display_field = &"radius"
display_unit = &"px"

[sub_resource type="Resource" id="up_push"]
script = ExtResource("3_up")
id = &"push"
label = "UPG_PUSH"
effects = Dictionary[StringName, PackedFloat64Array]({&"knockback": PackedFloat64Array(48.0, 56.0)})
display_field = &"knockback"
display_unit = &"px"

[sub_resource type="Resource" id="up_wound"]
script = ExtResource("3_up")
id = &"wound"
label = "UPG_DAMAGE"
effects = Dictionary[StringName, PackedFloat64Array]({&"damage": PackedFloat64Array(1.0, 2.0)})
display_field = &"damage"
display_unit = &""

[resource]
script = ExtResource("1_rd")
id = &"reverse_magnet"
display_name = "ITEM_REVERSE_MAGNET"
short_name = "RELIC_SHORT_MAGNET"
short_desc = "ITEM_REVERSE_MAGNET_DESC"
icon = ExtResource("4_icon")
shop_icon = ExtResource("5_shop")
trigger = &"pulse"
effect = &"repulse"
hold_when_empty = true
champion_mul = 0.5
base = SubResource("base")
upgrades = Array[ExtResource("3_up")]([SubResource("up_rate"), SubResource("up_reach"), SubResource("up_push"), SubResource("up_wound")])
max_upgrades = 5
