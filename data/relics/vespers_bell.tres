[gd_resource type="Resource" script_class="RelicData" format=3]

[ext_resource type="Script" path="res://src/data/relic_data.gd" id="1_rd"]
[ext_resource type="Script" path="res://src/data/relic_level_data.gd" id="2_rl"]
[ext_resource type="Script" path="res://src/data/weapon_upgrade_data.gd" id="3_up"]
[ext_resource type="Texture2D" path="res://assets/placeholders/itm_reverse_magnet.tres" id="4_icon"]

[sub_resource type="Resource" id="base"]
script = ExtResource("2_rl")
interval = 8.0
radius = 48.0
stun = 0.5

[sub_resource type="Resource" id="up_rate"]
script = ExtResource("3_up")
id = &"rate"
label = "UPG_COOLDOWN"
effects = Dictionary[StringName, PackedFloat64Array]({&"interval": PackedFloat64Array(7.0, 6.0)})
display_field = &"interval"
display_unit = &"s"

[sub_resource type="Resource" id="up_reach"]
script = ExtResource("3_up")
id = &"reach"
label = "UPG_RADIUS"
effects = Dictionary[StringName, PackedFloat64Array]({&"radius": PackedFloat64Array(56.0, 64.0)})
display_field = &"radius"
display_unit = &"px"

[sub_resource type="Resource" id="up_toll"]
script = ExtResource("3_up")
id = &"toll"
label = "UPG_STUN"
effects = Dictionary[StringName, PackedFloat64Array]({&"stun": PackedFloat64Array(0.65, 0.8)})
display_field = &"stun"
display_unit = &"s"

[resource]
script = ExtResource("1_rd")
id = &"vespers_bell"
display_name = "ITEM_VESPERS_BELL"
short_name = "RELIC_SHORT_BELL"
short_desc = "ITEM_VESPERS_BELL_DESC"
icon = ExtResource("4_icon")
shop_icon = ExtResource("4_icon")
trigger = &"pulse"
effect = &"stun"
hold_when_empty = true
champion_mul = 0.5
base = SubResource("base")
upgrades = Array[ExtResource("3_up")]([SubResource("up_rate"), SubResource("up_reach"), SubResource("up_toll")])
max_upgrades = 4
