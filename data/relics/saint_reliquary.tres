[gd_resource type="Resource" script_class="RelicData" format=3]

[ext_resource type="Script" path="res://src/data/relic_data.gd" id="1_rd"]
[ext_resource type="Script" path="res://src/data/relic_level_data.gd" id="2_rl"]
[ext_resource type="Script" path="res://src/data/weapon_upgrade_data.gd" id="3_up"]
[ext_resource type="Texture2D" path="res://assets/placeholders/itm_reverse_magnet.tres" id="4_icon"]

[sub_resource type="Resource" id="base"]
script = ExtResource("2_rl")
interval = 1.0
radius = 48.0
knockback = 48.0
damage = 2
iframes_bonus = 0.2

[sub_resource type="Resource" id="up_power"]
script = ExtResource("3_up")
id = &"power"
label = "UPG_DAMAGE"
effects = Dictionary[StringName, PackedFloat64Array]({&"damage": PackedFloat64Array(3.0, 4.0)})
display_field = &"damage"
display_unit = &""

[sub_resource type="Resource" id="up_reach"]
script = ExtResource("3_up")
id = &"reach"
label = "UPG_RADIUS"
effects = Dictionary[StringName, PackedFloat64Array]({&"radius": PackedFloat64Array(56.0, 64.0)})
display_field = &"radius"
display_unit = &"px"

[sub_resource type="Resource" id="up_rest"]
script = ExtResource("3_up")
id = &"rest"
label = "UPG_IFRAMES"
effects = Dictionary[StringName, PackedFloat64Array]({&"iframes_bonus": PackedFloat64Array(0.35, 0.5)})
display_field = &"iframes_bonus"
display_unit = &"s"

[resource]
script = ExtResource("1_rd")
id = &"saint_reliquary"
display_name = "ITEM_SAINT_RELIQUARY"
short_name = "RELIC_SHORT_RELIQUARY"
short_desc = "ITEM_SAINT_RELIQUARY_DESC"
icon = ExtResource("4_icon")
shop_icon = ExtResource("4_icon")
trigger = &"on_hit"
effect = &"burst"
hold_when_empty = false
champion_mul = 0.5
base = SubResource("base")
upgrades = Array[ExtResource("3_up")]([SubResource("up_power"), SubResource("up_reach"), SubResource("up_rest")])
max_upgrades = 4
