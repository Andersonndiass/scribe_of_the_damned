[gd_resource type="Resource" script_class="WeaponData" load_steps=10 format=3]

[ext_resource type="Script" path="res://src/data/weapon_data.gd" id="1_wd"]
[ext_resource type="Script" path="res://src/data/weapon_level_data.gd" id="2_lv"]
[ext_resource type="Texture2D" path="res://assets/placeholders/itm_weapon_copyist_quill.tres" id="3_icon"]
[ext_resource type="Script" path="res://src/data/weapon_upgrade_data.gd" id="9_up"]

[sub_resource type="Resource" id="base"]
script = ExtResource("2_lv")
damage = 1
interval = 0.8
range = 160.0
speed = 220.0
count = 2
width = 6.0

[sub_resource type="Resource" id="up_rate"]
script = ExtResource("9_up")
id = &"rate"
label = "UPG_RATE"
effects = Dictionary[StringName, PackedFloat64Array]({&"interval": PackedFloat64Array(0.71, 0.63, 0.56)})
display_field = &"interval"
display_unit = &"s"

[sub_resource type="Resource" id="up_drop"]
script = ExtResource("9_up")
id = &"drop"
label = "UPG_DROP"
effects = Dictionary[StringName, PackedFloat64Array]({&"count": PackedFloat64Array(3.0)})
display_field = &"count"
display_unit = &""

[sub_resource type="Resource" id="up_size"]
script = ExtResource("9_up")
id = &"size"
label = "UPG_SIZE"
effects = Dictionary[StringName, PackedFloat64Array]({&"width": PackedFloat64Array(8.0, 10.0)})
display_field = &"width"
display_unit = &"px"

[sub_resource type="Resource" id="up_slow"]
script = ExtResource("9_up")
id = &"slow"
label = "UPG_SLOW"
effects = Dictionary[StringName, PackedFloat64Array]({&"slow_factor": PackedFloat64Array(0.8), &"slow_time": PackedFloat64Array(1.0)})
display_field = &"slow_factor"
display_unit = &"slow"

[resource]
script = ExtResource("1_wd")
id = &"pen"
display_name = "WPN_PEN"
short_desc = "WPN_PEN_DESC"
icon = ExtResource("3_icon")
mode = &"auto"
pattern = &"burst"
base = SubResource("base")
upgrades = Array[ExtResource("9_up")]([SubResource("up_rate"), SubResource("up_drop"), SubResource("up_size"), SubResource("up_slow")])
max_upgrades = 6
