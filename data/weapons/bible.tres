[gd_resource type="Resource" script_class="WeaponData" load_steps=9 format=3]

[ext_resource type="Script" path="res://src/data/weapon_data.gd" id="1_wd"]
[ext_resource type="Script" path="res://src/data/weapon_level_data.gd" id="2_lv"]
[ext_resource type="Texture2D" path="res://assets/placeholders/itm_weapon_bible.tres" id="3_icon"]
[ext_resource type="Script" path="res://src/data/weapon_upgrade_data.gd" id="9_up"]

[sub_resource type="Resource" id="base"]
script = ExtResource("2_lv")
damage = 1
interval = 0.7
range = 200.0
speed = 0.0
count = 1
pierce = 2
width = 6.0

[sub_resource type="Resource" id="up_rate"]
script = ExtResource("9_up")
id = &"rate"
label = "UPG_RATE"
effects = Dictionary[StringName, PackedFloat64Array]({&"interval": PackedFloat64Array(0.6, 0.52, 0.46, 0.42)})
display_field = &"interval"
display_unit = &"s"

[sub_resource type="Resource" id="up_target"]
script = ExtResource("9_up")
id = &"target"
label = "UPG_TARGET"
effects = Dictionary[StringName, PackedFloat64Array]({&"pierce": PackedFloat64Array(3.0)})
display_field = &"pierce"
display_unit = &""

[sub_resource type="Resource" id="up_size"]
script = ExtResource("9_up")
id = &"size"
label = "UPG_SIZE"
effects = Dictionary[StringName, PackedFloat64Array]({&"range": PackedFloat64Array(230.0, 260.0), &"width": PackedFloat64Array(8.0, 10.0)})
display_field = &"range"
display_unit = &"px"

[resource]
script = ExtResource("1_wd")
id = &"bible"
display_name = "WPN_BIBLE"
short_desc = "WPN_BIBLE_DESC"
mode = &"aimed"
pattern = &"beam"
precision_mul = 1.5
aim_steps = 32
beam_min_length = 32.0
icon = ExtResource("3_icon")
base = SubResource("base")
upgrades = Array[ExtResource("9_up")]([SubResource("up_rate"), SubResource("up_target"), SubResource("up_size")])
max_upgrades = 6
